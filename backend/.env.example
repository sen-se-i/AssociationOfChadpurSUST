# ==============================================
# ACSUST Backend - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# ==============================================

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (from Supabase Dashboard -> Settings -> API -> anon public)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (from Supabase Dashboard -> Settings -> API -> service_role)
# ⚠️ NEVER expose this in frontend code! Only used in backend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Port (Render sets this automatically)
PORT=3001

# Frontend URL (for CORS - the URL where your website is hosted)
# Use comma-separated values for multiple origins
FRONTEND_URL=http://localhost:5500,https://your-site.com
